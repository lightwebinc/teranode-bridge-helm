{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "teranode-bridge values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "pullPolicy"
      ]
    },
    "networking": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "pod",
            "host"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "legacyPrefix": {
          "type": "boolean"
        },
        "txSizeHistogram": {
          "type": "boolean"
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "clusterSelectorLabel": {
              "type": "string",
              "minLength": 1
            },
            "rules": {
              "type": "array"
            },
            "additionalRules": {
              "type": "array"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": [
                "",
                "Cluster",
                "Local"
              ]
            }
          }
        }
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "txListen": {
          "type": "string",
          "pattern": ":[0-9]{1,5}$"
        },
        "subtreeListen": {
          "type": "string",
          "pattern": ":[0-9]{1,5}$"
        },
        "blockListen": {
          "type": "string",
          "pattern": ":[0-9]{1,5}$"
        },
        "retrievalListen": {
          "type": "string",
          "pattern": ":[0-9]{1,5}$"
        },
        "metricsAddr": {
          "type": "string",
          "pattern": ":[0-9]{1,5}$",
          "description": "Set metrics.enabled=false to switch the listener off; an empty value here would silently fall back to the binary default [::]:9146."
        },
        "maxObject": {
          "type": "integer",
          "minimum": 0
        },
        "advertise": {
          "type": "string",
          "pattern": "^$|^https?://[^ ]+$",
          "description": "Base URL the Teranode cluster dials for pulls \u2014 scheme required, API prefix NOT included (the announced URL is advertise + apiPrefix; the chart refuses a doubled path)."
        },
        "apiPrefix": {
          "type": "string",
          "pattern": "^/"
        },
        "propagation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[^ ]+$"
          }
        },
        "kafka": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subtreeTopic": {
          "type": "string",
          "minLength": 1
        },
        "blockTopic": {
          "type": "string",
          "minLength": 1
        },
        "peerId": {
          "type": "string",
          "pattern": "^$|^12D3KooW[1-9A-HJ-NP-Za-km-z]{44}$",
          "description": "SYNTHETIC valid-format libp2p peer id (12D3KooW\u2026) derived from a fresh ed25519 key, registered with no p2p service. Required when announcements are configured \u2014 empty is refused at install time: the cluster's catchup substitutes the announce URL for a missing id, targets the bridge for the header chain, 404s, and circuit-breaks itself out of recovery. The unregistered id diverts catchup to real libp2p peers while delivery gates (bans only) keep pulling from the bridge. One id per bridge instance; never a real peer's."
        },
        "blockchain": {
          "type": "string"
        },
        "localAsset": {
          "type": "string",
          "pattern": "^$|^https?://[^ ]+$",
          "description": "Cluster asset base URL INCLUDING its API prefix \u2014 unlike advertise, this one is dialled exactly as given."
        },
        "edgeIngress": {
          "type": "string"
        },
        "edgeSubtreePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "edgeBlockPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "submitter": {
          "type": "boolean",
          "description": "Hold the reverse-path submitter role. Exactly one bridge per class per cluster may hold it; rendered unconditionally as -submitter=<value> because the binary default is true."
        },
        "mineTag": {
          "type": "string"
        },
        "txBatch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "txBatchBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31457280
        },
        "txLinger": {
          "type": "string"
        },
        "txInflight": {
          "type": "integer",
          "minimum": 0
        },
        "txBuilders": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            4,
            8,
            16
          ],
          "description": "Power of two, max 16 \u2014 the binary rounds anything else DOWN to one, so a value of 6 silently becomes 4."
        },
        "txRetries": {
          "type": "integer",
          "minimum": 0
        },
        "cacheBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "PER CACHE, and there are two (objects and transactions): the process ceiling is twice this."
        },
        "cacheTtl": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "sink"
          ]
        },
        "statsEvery": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "instanceId": {
          "type": "string"
        },
        "debug": {
          "type": "boolean"
        },
        "clusterPoll": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "strict": {
          "type": "boolean"
        }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectorUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "sampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "profiling": {
      "type": "object",
      "properties": {
        "blockProfileRate": {
          "type": "integer",
          "minimum": 0
        },
        "mutexProfileFraction": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "readiness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
